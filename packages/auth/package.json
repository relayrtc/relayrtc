{
  "name": "@relayrtc/auth",
  "version": "0.0.0",
  "description": "Better Auth configuration and clients for RelayRTC dashboard accounts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "import": "./dist/projects.js"
    },
    "./api-keys": {
      "types": "./dist/api-keys.d.ts",
      "import": "./dist/api-keys.js"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "import": "./dist/activity.js"
    },
    "./activity-features": {
      "types": "./dist/activity-features.d.ts",
      "import": "./dist/activity-features.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --exclude dist/**",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@relayrtc/protocol": "workspace:*",
    "@relayrtc/database": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "resend": "6.31.0",
    "zod": "^4.6.5",
    "@relayrtc/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
