{
  "name": "@relayrtc/protocol",
  "version": "0.1.2",
  "description": "Versioned realtime wire contracts for RelayRTC.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./egress-security": {
      "types": "./dist/egress-security.d.ts",
      "import": "./dist/egress-security.js"
    },
    "./streaming-control": {
      "types": "./dist/streaming-control.d.ts",
      "import": "./dist/streaming-control.js"
    },
    "./media-control": {
      "types": "./dist/media-control.d.ts",
      "import": "./dist/media-control.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhook-signature": {
      "types": "./dist/webhook-signature.d.ts",
      "import": "./dist/webhook-signature.js"
    },
    "./webhook-security": {
      "types": "./dist/webhook-security.d.ts",
      "import": "./dist/webhook-security.js"
    },
    "./credential-policy": {
      "types": "./dist/credential-policy.d.ts",
      "import": "./dist/credential-policy.js"
    },
    "./mixer-png": {
      "types": "./dist/mixer-png.d.ts",
      "import": "./dist/mixer-png.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --exclude dist/**",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@relayrtc/types": "workspace:*",
    "@relayrtc/validation": "workspace:*",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  },
  "homepage": "https://docs.relayrtc.com/reference/api/v1/overview",
  "repository": {
    "type": "git",
    "url": "https://github.com/relayrtc/relayrtc.git",
    "directory": "packages/protocol"
  },
  "bugs": "https://github.com/relayrtc/relayrtc/issues"
}
