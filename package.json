{
  "name": "relayrtc",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source realtime communication infrastructure for developers.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "db:check": "pnpm --filter @relayrtc/database db:check",
    "db:generate": "pnpm --filter @relayrtc/database db:generate",
    "db:migrate": "pnpm --filter @relayrtc/database db:migrate",
    "docker:config": "docker compose --env-file .env config --quiet",
    "docker:down": "docker compose --env-file .env down",
    "docker:logs": "docker compose --env-file .env logs --follow",
    "docker:status": "docker compose --env-file .env ps",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:up:streaming": "node scripts/docker-up.mjs --streaming",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:config": "docker compose --env-file .env config --quiet",
    "infra:down": "docker compose --env-file .env down",
    "infra:logs": "docker compose --env-file .env logs --follow",
    "infra:status": "docker compose --env-file .env ps",
    "infra:up": "docker compose --env-file .env up --detach --wait postgres coturn prometheus grafana",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
