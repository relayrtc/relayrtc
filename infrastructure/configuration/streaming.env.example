# Included automatically in .env by configure-env.mjs for every installation.
# Keep all generated credentials across restarts and back up encryption keys.
RELAYRTC_STREAMING_ENABLED=true
STREAMING_SIGNING_SECRET=
STREAMING_WORKER_KEY=
STREAMING_GATEWAY_KEY=
STREAMING_DESTINATION_ENCRYPTION_KEY=
STREAMING_S3_ACCESS_KEY=
STREAMING_S3_SECRET_KEY=
STREAMING_STORAGE_ROOT_USER=
STREAMING_STORAGE_ROOT_PASSWORD=

# Empty values are initialized from the base host ports/origins for local use.
# Override with public HTTPS/RTMP(S)/WSS addresses for a server deployment.
STREAMING_PUBLIC_ORIGIN=
STREAMING_PUBLIC_RTMP_ORIGIN=rtmp://localhost:1935
STREAMING_GUEST_SIGNALING_URL=
STREAMING_ALLOWED_ORIGINS=
STREAMING_INGEST_BIND=127.0.0.1
STREAMING_WEBRTC_HOSTS=127.0.0.1

# Exact public playlist/segment/redirect hosts. Empty disables external HLS pulls.
STREAMING_SOURCE_ALLOWED_HOSTS=
