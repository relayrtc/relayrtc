    },
    {
      "id": 11,
      "type": "stat",
      "title": "Destination egress bytes",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "relayrtc_broadcast_egress_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Destination transcode time",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "relayrtc_broadcast_transcode_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "DVR active and draining windows",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "relayrtc_dvr_active + relayrtc_dvr_draining",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
