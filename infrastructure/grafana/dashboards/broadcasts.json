        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "relayrtc_broadcast_queue_delay_seconds",
          "legendFormat": "queue"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
