{
  "uid": "relayrtc-broadcasts",
  "title": "Broadcast orchestration",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "relayrtc",
    "broadcasts"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Run states",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "relayrtc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "relayrtc_broadcast_runs",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Eligible output queue age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "relayrtc-prometheus"
      },
      "gridPos": {
