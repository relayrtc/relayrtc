        "type": "prometheus",
        "uid": "relayrtc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(relayrtc_broadcast_worker_failures_total[5m])",
