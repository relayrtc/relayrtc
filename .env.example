RELAYRTC_VERSION=0.1.0
POSTGRES_DB=relaykit
POSTGRES_USER=relaykit
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://relaykit:replace-with-a-random-password@localhost:5433/relaykit
CONSOLE_PORT=3002
API_PORT=8080
USAGE_RETENTION_DAYS=365
RELAYRTC_API_URL=http://localhost:8080
API_LOG_LEVEL=info
API_TRUST_PROXY=false
SIGNALING_PORT=8081
MEDIA_PORT=8083
MEDIA_LOG_LEVEL=info
MEDIA_NODE_ID=media-local
MEDIA_WORKERS=1
MEDIA_MAX_ROOMS_PER_WORKER=100
MEDIA_MAX_TRANSPORTS_PER_ROOM=200
MEDIA_RTC_LISTEN_IP=0.0.0.0
MEDIA_RTC_ANNOUNCED_ADDRESS=127.0.0.1
MEDIA_RTC_PORT=40000
MEDIA_RTC_MAX_PORT=40003
RELAYRTC_SIGNALING_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3005,http://127.0.0.1:3000,http://127.0.0.1:3002,http://127.0.0.1:3005
RELAYRTC_SIGNALING_HEARTBEAT_INTERVAL=20s
RELAYRTC_SIGNALING_PONG_TIMEOUT=60s
RELAYRTC_SIGNALING_RECOVERY_TIMEOUT=30s
RELAYRTC_SIGNALING_WRITE_TIMEOUT=10s
RELAYRTC_SIGNALING_MAX_MESSAGE_BYTES=65536
RELAYRTC_SIGNALING_NODE_ID=signaling-local
RELAYRTC_IPINFO_TOKEN=
PARTICIPANT_TOKEN_AUDIENCE=relayrtc-realtime
PARTICIPANT_TOKEN_ISSUER=relayrtc-api
PARTICIPANT_TOKEN_KEY_ID=participant-v1
RELAYRTC_INTERNAL_SECRET=replace-with-at-least-32-random-characters
PARTICIPANT_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_SIGNING_ENCRYPTION_KEY=

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3002
# Skip signup/sign-in email verification when true (default: false).
SKIP_EMAIL_VERIFICATION=false
RELAYRTC_ACCOUNT_API_ENABLED=true
BETTER_AUTH_TRUSTED_ORIGINS=
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL="RelayRTC <noreply@example.com>"

TURN_REALM=relayrtc.local
TURN_SHARED_SECRET=replace-with-at-least-32-random-characters
TURN_PUBLIC_IP=127.0.0.1
TURN_DOCKER_RELAY_ADDRESS=172.30.0.11
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_TLS_CERT_FILE=/etc/coturn/tls/tls.crt
TURN_TLS_PRIVATE_KEY_FILE=/etc/coturn/tls/tls.key
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp,turns:localhost:5349?transport=tcp
RTC_MIN_PORT=49160
RTC_MAX_PORT=49200

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password

RELAYRTC_TRUSTED_PROXY_CIDRS=
RELAYRTC_STORE_PARTICIPANT_IP=false
RELAYRTC_LOCATION_RETENTION=168h
API_TRUSTED_PROXY_CIDRS=

API_REQUESTS_PER_IP_PER_MINUTE=600
API_REQUESTS_PER_KEY_PER_MINUTE=1200
API_REQUESTS_PER_PROJECT_PER_MINUTE=3000
API_REQUESTS_PER_ROOM_PER_MINUTE=1200
API_LIMIT_TRACKED_SCOPES=10000
MEDIA_MAX_PRODUCERS_PER_ROOM=100
MEDIA_MAX_CONSUMERS_PER_ROOM=600
RELAYRTC_SIGNALING_MAX_CONNECTIONS=4096
RELAYRTC_SIGNALING_MAX_CONNECTIONS_PER_IP=128
RELAYRTC_SIGNALING_MAX_CONNECTIONS_PER_PROJECT=1024
RELAYRTC_SIGNALING_MAX_CONNECTIONS_PER_ROOM=256
RELAYRTC_SIGNALING_CONNECTS_PER_IP_PER_MINUTE=120
RELAYRTC_SIGNALING_MESSAGES_PER_CONNECTION_PER_SECOND=60
RELAYRTC_SIGNALING_MESSAGES_PER_IP_PER_SECOND=600
RELAYRTC_SIGNALING_MESSAGES_PER_PROJECT_PER_SECOND=2000
RELAYRTC_SIGNALING_MESSAGES_PER_ROOM_PER_SECOND=1000
RELAYRTC_SIGNALING_OUTBOUND_MESSAGES=64
RELAYRTC_SIGNALING_OUTBOUND_BYTES=2097152
RELAYRTC_SIGNALING_LIMIT_TRACKED_SCOPES=10000
API_REQUESTS_PER_NODE_PER_MINUTE=10000
RELAYRTC_SIGNALING_MESSAGES_PER_NODE_PER_SECOND=10000
MEDIA_MAX_TRANSPORTS_PER_PARTICIPANT=4
MEDIA_MAX_PRODUCERS_PER_PARTICIPANT=4
MEDIA_MAX_CONSUMERS_PER_PARTICIPANT=128
