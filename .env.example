# RelayRTC 0.1.2. Run node scripts/configure-env.mjs to generate missing secrets.
# This template uses localhost. Set reachable addresses and HTTPS before remote use.
# Optional tuning: infrastructure/configuration/advanced.env.example
RELAYRTC_VERSION=0.1.2

# Host ports; container-to-container addresses are supplied by Compose.
API_PORT=8080
CONSOLE_PORT=3002
SIGNALING_PORT=8081
MEDIA_PORT=8083
POSTGRES_PORT=5433

# Console origin and the exact browser origins permitted to join calls.
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3002
RELAYRTC_SIGNALING_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3005
MEDIA_RTC_ANNOUNCED_ADDRESS=127.0.0.1
TURN_PUBLIC_IP=127.0.0.1
TURN_STUN_URLS=stun:localhost:3478
# Trusted TURN TLS needs a certificate/mount; local defaults use UDP and TCP.
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp

# Generated independently by configure-env. Keep these values across restarts.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
PARTICIPANT_TOKEN_SIGNING_SECRET=
RELAYRTC_INTERNAL_SECRET=
TURN_SHARED_SECRET=
GRAFANA_ADMIN_PASSWORD=
# Standard base64 encoding of 32 random bytes; required for webhook secrets.
WEBHOOK_SIGNING_ENCRYPTION_KEY=

# Supply your provider credentials. All three providers are required by current auth.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="RelayRTC <noreply@example.com>"
SKIP_EMAIL_VERIFICATION=false

# Streaming is part of the standard installation. Configuration preparation
# adds its credentials and addresses from infrastructure/configuration/streaming.env.example.
RELAYRTC_STREAMING_ENABLED=true
