RELAYRTC_VERSION=0.1.1
POSTGRES_DB=relaykit
POSTGRES_USER=relaykit
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://relaykit:replace-with-a-random-password@localhost:5433/relaykit
CONSOLE_PORT=3002
API_PORT=8080
USAGE_RETENTION_DAYS=365
RELAYRTC_API_URL=http://localhost:8080
API_LOG_LEVEL=info
API_TRUST_PROXY=false
SIGNALING_PORT=8081
MEDIA_PORT=8083
MEDIA_LOG_LEVEL=info
MEDIA_NODE_ID=media-local
MEDIA_WORKERS=1
MEDIA_MAX_ROOMS_PER_WORKER=100
MEDIA_MAX_TRANSPORTS_PER_ROOM=200
MEDIA_RTC_LISTEN_IP=0.0.0.0
MEDIA_RTC_ANNOUNCED_ADDRESS=127.0.0.1
MEDIA_RTC_ADDITIONAL_ANNOUNCED_ADDRESSES=172.30.0.10
MEDIA_RTC_PORT=40000
MEDIA_RTC_MAX_PORT=40003
RELAYRTC_SIGNALING_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3005,http://127.0.0.1:3000,http://127.0.0.1:3002,http://127.0.0.1:3005
RELAYRTC_SIGNALING_HEARTBEAT_INTERVAL=20s
RELAYRTC_SIGNALING_PONG_TIMEOUT=60s
RELAYRTC_SIGNALING_RECOVERY_TIMEOUT=30s
RELAYRTC_SIGNALING_WRITE_TIMEOUT=10s
RELAYRTC_SIGNALING_MAX_MESSAGE_BYTES=65536
RELAYRTC_SIGNALING_NODE_ID=signaling-local
RELAYRTC_IPINFO_TOKEN=
PARTICIPANT_TOKEN_AUDIENCE=relayrtc-realtime
PARTICIPANT_TOKEN_ISSUER=relayrtc-api
PARTICIPANT_TOKEN_KEY_ID=participant-v1
RELAYRTC_INTERNAL_SECRET=replace-with-at-least-32-random-characters
PARTICIPANT_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_SIGNING_ENCRYPTION_KEY=

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3002
SKIP_EMAIL_VERIFICATION=true
RELAYRTC_ACCOUNT_API_ENABLED=true
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL="RelayRTC <noreply@example.com>"

TURN_REALM=relayrtc.local
TURN_SHARED_SECRET=replace-with-at-least-32-random-characters
TURN_PUBLIC_IP=127.0.0.1
TURN_DOCKER_RELAY_ADDRESS=172.30.0.11
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_TLS_CERT_FILE=/etc/coturn/tls/tls.crt
TURN_TLS_PRIVATE_KEY_FILE=/etc/coturn/tls/tls.key
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp,turns:localhost:5349?transport=tcp
RTC_MIN_PORT=49160
RTC_MAX_PORT=49200

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password

RELAYRTC_TRUSTED_PROXY_CIDRS=
RELAYRTC_STORE_PARTICIPANT_IP=false
RELAYRTC_LOCATION_RETENTION=168h
API_TRUSTED_PROXY_CIDRS=

API_REQUESTS_PER_IP_PER_MINUTE=600
API_MEDIA_REQUESTS_PER_NODE_PER_MINUTE=100000
API_MEDIA_REQUESTS_PER_IP_PER_MINUTE=12000
API_REQUESTS_PER_KEY_PER_MINUTE=1200
API_REQUESTS_PER_PROJECT_PER_MINUTE=3000
API_REQUESTS_PER_ROOM_PER_MINUTE=1200
API_LIMIT_TRACKED_SCOPES=10000
MEDIA_MAX_PRODUCERS_PER_ROOM=100
MEDIA_MAX_CONSUMERS_PER_ROOM=600
RELAYRTC_SIGNALING_MAX_CONNECTIONS=4096
RELAYRTC_SIGNALING_MAX_CONNECTIONS_PER_IP=128
RELAYRTC_SIGNALING_MAX_CONNECTIONS_PER_PROJECT=1024
RELAYRTC_SIGNALING_MAX_CONNECTIONS_PER_ROOM=256
RELAYRTC_SIGNALING_CONNECTS_PER_IP_PER_MINUTE=120
RELAYRTC_SIGNALING_MESSAGES_PER_CONNECTION_PER_SECOND=60
RELAYRTC_SIGNALING_MESSAGES_PER_IP_PER_SECOND=600
RELAYRTC_SIGNALING_MESSAGES_PER_PROJECT_PER_SECOND=2000
RELAYRTC_SIGNALING_MESSAGES_PER_ROOM_PER_SECOND=1000
RELAYRTC_SIGNALING_OUTBOUND_MESSAGES=64
RELAYRTC_SIGNALING_OUTBOUND_BYTES=2097152
RELAYRTC_SIGNALING_LIMIT_TRACKED_SCOPES=10000
API_REQUESTS_PER_NODE_PER_MINUTE=10000
RELAYRTC_SIGNALING_MESSAGES_PER_NODE_PER_SECOND=10000
MEDIA_MAX_TRANSPORTS_PER_PARTICIPANT=4
MEDIA_MAX_PRODUCERS_PER_PARTICIPANT=4
MEDIA_MAX_CONSUMERS_PER_PARTICIPANT=128

RELAYRTC_STREAMING_ENABLED=false
STREAMING_SIGNING_SECRET=
STREAMING_WORKER_KEY=
STREAMING_GATEWAY_KEY=
STREAMING_PUBLIC_ORIGIN=http://localhost:8080
STREAMING_PUBLIC_RTMP_ORIGIN=rtmp://localhost:1935
STREAMING_GATEWAY_API_ORIGIN=http://streaming-gateway:9997
STREAMING_GATEWAY_WHIP_ORIGIN=http://streaming-gateway:8889
STREAMING_GATEWAY_HLS_ORIGIN=http://streaming-gateway:8888
STREAMING_GATEWAY_RTSP_ORIGIN=rtsp://streaming-gateway:8554
STREAMING_WORKER_RTP_IP=172.30.0.20
STREAMING_S3_ENDPOINT=http://streaming-storage:9000
STREAMING_S3_REGION=us-east-1
STREAMING_S3_BUCKET=relayrtc-streaming

STREAMING_S3_ACCESS_KEY=
STREAMING_S3_SECRET_KEY=
STREAMING_STORAGE_ROOT_USER=
STREAMING_STORAGE_ROOT_PASSWORD=
STREAMING_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3005,http://127.0.0.1:3002
STREAMING_MAX_SESSIONS=8
STREAMING_MAX_STREAMS_PER_ENVIRONMENT=100

STREAMING_API_ORIGIN=http://api:8080
STREAMING_WORKER_ID=streaming-local-1
STREAMING_RTP_PORT_BASE=20000
STREAMING_HEALTH_PORT=8090
STREAMING_FFMPEG=ffmpeg
STREAMING_FFPROBE=ffprobe

STREAMING_INGEST_BIND=127.0.0.1
STREAMING_WEBRTC_HOSTS=127.0.0.1
STREAMING_RTMP_ENCRYPTION=no
STREAMING_CERTS_DIRECTORY=./.streaming/certs

STREAMING_BROADCASTS_ENABLED=true
STREAMING_MAX_BROADCASTS=16
STREAMING_MAX_BROADCASTS_PER_ENVIRONMENT=4
STREAMING_MAX_OUTPUT_JOBS=16
STREAMING_MAX_OUTPUT_JOBS_PER_WORKER=4
STREAMING_OUTPUT_CONCURRENCY=4

# Destination credentials use a separate base64-encoded 32-byte encryption key.
STREAMING_DESTINATION_ENCRYPTION_KEY=
STREAMING_MAX_DESTINATIONS=8
STREAMING_MAX_EGRESS_BITRATE=24000000
STREAMING_MAX_EGRESS_BYTES=20000000000

STREAMING_MAX_RECORDINGS=4
STREAMING_MAX_RECORDINGS_PER_ENVIRONMENT=2
STREAMING_MAX_RECORDING_BYTES=536870912

STREAMING_MAX_SCHEDULES=1000
STREAMING_MAX_SCHEDULES_PER_ENVIRONMENT=100
STREAMING_SCHEDULE_NOTIFICATIONS_ENABLED=false

# Exact public hosts permitted for all external HLS manifests and segments. Empty disables pulls.
STREAMING_SOURCE_ALLOWED_HOSTS=
STREAMING_MAX_SOURCE_JOBS=4

# Clips share the recording worker and private asset storage.
STREAMING_MAX_CLIP_JOBS=4
STREAMING_MAX_CLIPS_PER_MINUTE=10
STREAMING_MAX_CLIP_DURATION_SECONDS=120
STREAMING_GUESTS_ENABLED=true
STREAMING_GUEST_SIGNALING_URL=ws://localhost:8081/v1/connect
STREAMING_DVR_ENABLED=true
STREAMING_MAX_BUFFERS_PER_ENVIRONMENT=2
STREAMING_MAX_BUFFERS=4

# CPU mixers share the canonical streaming worker/program identity.
STREAMING_MIXERS_ENABLED=true
STREAMING_MAX_MIXERS=2
STREAMING_MAX_MIXERS_PER_ENVIRONMENT=1

# One canonical worker can normalize multiple independent mixer inputs.
STREAMING_WORKER_CONCURRENCY=4
STREAMING_WORKER_CPUS=4
STREAMING_WORKER_MEMORY=4g
